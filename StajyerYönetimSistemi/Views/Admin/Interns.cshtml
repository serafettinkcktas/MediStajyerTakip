@{
    ViewData["Title"] = "Stajyer Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xl">
    <!-- Sayfa Başlığı ve Yeni Ekle Butonu -->
    <div class="page-header d-print-none my-3">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title">Stajyer Yönetimi</h2>
                <div class="text-muted mt-1">Sistemdeki tüm stajyerlerin listesini, iletişim bilgilerini ve durumlarını buradan yönetebilirsiniz.</div>
            </div>
            <div class="col-auto ms-auto">
                <button type="button" class="btn btn-primary" onclick="openCreateModal()">
                    Yeni Stajyer Ekle
                </button>
            </div>
        </div>
    </div>

    <!-- STAJYER TABLOSU (BOŞ DURUM) -->
    <div class="card shadow-sm border-0 bg-white">
        <div class="table-responsive p-3">
            <table id="internsTable" class="table table-vcenter card-table table-striped">
                <thead>
                    <tr>
                        <th>Ad Soyad</th>
                        <th>İletişim</th>
                        <th>Eğitim Bilgileri</th>
                        <th>Atanan Mentor</th>
                        <th>Staj Dönemi</th>
                        <th>Durum</th>
                        <th class="w-1">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Veri tabanı bağlandığında döngü buraya gelecek -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- YENİ STAJYER EKLEME MODALI (EKRANIN ORTASINDA AÇILAN PENCERE) -->
<div class="modal modal-blur fade" id="createInternModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Yeni Stajyer Kaydı</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <form id="createInternForm">
                    <div class="row mb-3">
                        <div class="col-lg-6">
                            <label class="form-label required">Ad Soyad</label>
                            <input type="text" class="form-control" placeholder="Örn: Ahmet Yılmaz" required id="internName">
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label required">Telefon</label>
                            <input type="text" class="form-control" placeholder="Örn: 0555 123 4567" required id="internPhone">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-lg-6">
                            <label class="form-label required">E-Posta</label>
                            <input type="email" class="form-control" placeholder="Örn: ahmet@mail.com" required id="internEmail">
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label required">Üniversite</label>
                            <input type="text" class="form-control" placeholder="Örn: A Üniversitesi" required id="internUni">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-lg-6">
                            <label class="form-label required">Bölüm</label>
                            <input type="text" class="form-control" placeholder="Örn: Bilgisayar Mühendisliği" required id="internDept">
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label required">Sınıf</label>
                            <select class="form-select" required id="internClass">
                                <option value="1. Sınıf">1. Sınıf</option>
                                <option value="2. Sınıf">2. Sınıf</option>
                                <option value="3. Sınıf" selected>3. Sınıf</option>
                                <option value="4. Sınıf">4. Sınıf</option>
                                <option value="Mezun">Mezun</option>
                            </select>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-lg-6">
                            <label class="form-label required">Atanacak Mentor</label>
                            <select class="form-select" required id="internMentor">
                                <option value="" disabled selected>Mentor Seçiniz...</option>
                            </select>
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label required">Durum</label>
                            <select class="form-select" required id="internStatus">
                                <option value="Aktif" selected>Aktif</option>
                                <option value="Pasif">Pasif</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-6">
                            <label class="form-label required">Staj Başlangıç Tarihi</label>
                            <input type="date" class="form-control" required id="internStartDate">
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label required">Staj Bitiş Tarihi</label>
                            <input type="date" class="form-control" required id="internEndDate">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link link-secondary me-auto" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn btn-primary" onclick="submitInternForm()">Kaydet ve Listeye Ekle</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // DataTable entegrasyonu (Tablo boş olsa bile otomatik 'Veri bulunamadı' yazar)
            $('#internsTable').DataTable({
                "language": {
                    "url": "https://cdn.datatables.net/plug-ins/1.10.24/i18n/Turkish.json"
                },
                "responsive": true,
                "searching": true,
                "paging": true
            });
        });

        function openCreateModal() {
            // Butona basıldığında gizli olan pencereyi (modalı) açar
            $('#createInternModal').modal('show');
        }

        function submitInternForm() {
            var form = document.getElementById('createInternForm');
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }
            $('#createInternModal').modal('hide');
            form.reset();
            alert("Stajyer kaydı simülasyon olarak başarıyla tamamlandı!");
        }
    </script>
}