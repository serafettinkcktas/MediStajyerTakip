@{
    ViewData["Title"] = "Duyurular";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xl">
    <div class="page-header d-print-none my-3">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title">Duyuru Yönetimi</h2>
                <div class="text-muted mt-1">Stajyerlere iletilen genel duyurular ve bilgilendirmeler.</div>
            </div>
            <div class="col-auto ms-auto">
                <button type="button" class="btn btn-primary" onclick="alert('Yeni duyuru formu simüle edildi!')">
                    Yeni Duyuru Yayınla
                </button>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 bg-white">
        <div class="table-responsive p-3">
            <table id="announcementsTable" class="table table-vcenter card-table table-striped">
                <thead>
                    <tr>
                        <th>Başlık</th>
                        <th>Yayınlayan</th>
                        <th>Yayın Tarihi</th>
                        <th>Hedef Kitle</th>
                        <th class="w-1">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Veri tabanı döngüsü buraya gelecek -->
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#announcementsTable').DataTable({
                "language": {
                    "url": "https://cdn.datatables.net/plug-ins/1.10.24/i18n/Turkish.json"
                },
                "responsive": true
            });
        });
    </script>
}