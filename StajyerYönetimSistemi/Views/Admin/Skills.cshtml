@{
    ViewData["Title"] = "Yetenek Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xl">
    <!-- Sayfa Başlığı -->
    <div class="page-header d-print-none my-3">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title">Yetenek Yönetimi</h2>
                <div class="text-muted mt-1">Stajyerlerin teknik ve kişisel yetkinlik envanterini görüntüleyebilir ve seviyelerini güncelleyebilirsiniz.</div>
            </div>
        </div>
    </div>

    <!-- STAJYER YETENEK KARTLARI LİSTESİ -->
    <div class="row row-cards">
        <div class="row row-cards">
            <!-- Boş Durum (Empty State) Uyarısı -->
            <div class="col-12 text-center py-5">
                <div class="text-muted mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-user-off text-secondary" width="48" height="48" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                        <path d="M8 7a4 4 0 1 1 8 0m0 4v1a4 4 0 0 1 -4 4h-1"></path>
                        <path d="M6 21v-2a4 4 0 0 1 4 -4h4"></path>
                    </svg>
                </div>
                <h3 class="text-secondary">Yetenek Profili Bulunmamaktadır</h3>
                <p class="text-muted">Sisteme kayıtlı stajyer bulunmadığı için yetenek matrisi henüz oluşturulmadı.</p>
            </div>
        </div>

<!-- YETENEK GÜNCELLEME MODALI -->
<div class="modal modal-blur fade" id="updateSkillModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><span id="targetInternName"></span> - Yetenek Seviyesi Güncelleme</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <form id="skillUpdateForm">
                    <!-- TEKNİK YETENEKLER SEKSİYONU -->
                    <h4 class="mb-3 text-blue">Teknik Yetenekler</h4>
                    <div class="row mb-4">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">C# Seviyesi</label>
                            <select class="form-select" id="skill-csharp">
                                <option value="Başlangıç">Başlangıç</option>
                                <option value="Temel">Temel</option>
                                <option value="Orta">Orta</option>
                                <option value="İyi" selected>İyi</option>
                                <option value="İleri">İleri</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">ASP.NET Core</label>
                            <select class="form-select" id="skill-dotnet">
                                <option value="Başlangıç">Başlangıç</option>
                                <option value="Temel">Temel</option>
                                <option value="Orta" selected>Orta</option>
                                <option value="İyi">İyi</option>
                                <option value="İleri">İleri</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">SQL / DB</label>
                            <select class="form-select" id="skill-sql">
                                <option value="Başlangıç">Başlangıç</option>
                                <option value="Temel">Temel</option>
                                <option value="Orta">Orta</option>
                                <option value="İyi" selected>İyi</option>
                                <option value="İleri">İleri</option>
                            </select>
                        </div>
                    </div>

                    <!-- KİŞİSEL YETENEKLER SEKSİYONU -->
                    <h4 class="mb-3 text-success">Kişisel Yetenekler</h4>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">İletişim</label>
                            <select class="form-select" id="skill-comm">
                                <option value="Başlangıç">Başlangıç</option>
                                <option value="Temel">Temel</option>
                                <option value="Orta">Orta</option>
                                <option value="İyi">İyi</option>
                                <option value="İleri" selected>İleri</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Problem Çözme</label>
                            <select class="form-select" id="skill-problem">
                                <option value="Başlangıç">Başlangıç</option>
                                <option value="Temel">Temel</option>
                                <option value="Orta">Orta</option>
                                <option value="İyi" selected>İyi</option>
                                <option value="İleri">İleri</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Zaman Yönetimi</label>
                            <select class="form-select" id="skill-time">
                                <option value="Başlangıç">Başlangıç</option>
                                <option value="Temel">Temel</option>
                                <option value="Orta" selected>Orta</option>
                                <option value="İyi">İyi</option>
                                <option value="İleri">İleri</option>
                            </select>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link link-secondary me-auto" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn btn-primary" onclick="submitSkillUpdate()">Yetenek Seviyelerini Kaydet</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 1. Yetenek Güncelleme Modalını Aç
        function openSkillUpdateModal(internName, type) {
            $('#targetInternName').text(internName);
            $('#updateSkillModal').modal('show');
        }

        // 2. Güncelleme Simülasyonu
        function submitSkillUpdate() {
            var intern = $('#targetInternName').text();
            alert(intern + " isimli stajyerin yetenek envanteri başarıyla güncellendi!");
            $('#updateSkillModal').modal('hide');
        }
    </script>
}
</div>
</div>