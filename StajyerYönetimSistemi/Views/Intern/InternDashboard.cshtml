@{
    ViewData["Title"] = "Stajyer Paneli";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xl">
    <!-- Karşılama Başlığı -->
    <div class="page-header d-print-none my-3">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title">Hoş Geldin, Stajyer! 👋</h2>
                <div class="text-muted mt-1">Bugünkü görevlerini takip edebilir ve günlük çalışma raporunu buradan gönderebilirsin.</div>
            </div>
            <div class="col-auto ms-auto">
                <a href="/Report/DailyReport" class="btn btn-success">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-file-pencil" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M14 3v4a1 1 0 0 0 1 1h4" /><path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z" /><path d="M10 18l5 -5a1.5 1.5 0 0 0 -3 -3l-5 5v3h3z" /></svg>
                    Günlük Rapor Doldur
                </a>
            </div>
        </div>
    </div>

    <div class="row row-cards">
        <!-- ATANAN MENTOR BİLGİSİ -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 bg-white">
                <div class="card-body">
                    <div class="subheader">Danışman / Mentor</div>
                    <div class="d-flex align-items-center mt-2">
                        <span class="avatar avatar-md me-3 bg-blue-lt">M</span>
                        <div>
                            <div class="h3 mb-0">Henüz Mentor Atanmadı</div>
                            <div class="text-muted small">Sistem Yetkilisi</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- BUGÜNKÜ GÖREV -->
        <div class="col-md-8">
            <div class="card shadow-sm border-0 bg-white">
                <div class="card-body">
                    <h3 class="card-title">Bugünkü Görevim</h3>
                    <div class="p-4 text-center bg-light rounded text-muted">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-checkbox mb-2 text-secondary" width="36" height="36" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M9 11l3 3l8 -8" /><path d="M20 12v6a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h9" /></svg>
                        <p class="mb-0 small">Şu an üzerinize atanmış aktif bir görev bulunmamaktadır.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>