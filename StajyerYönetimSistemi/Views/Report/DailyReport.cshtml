@{
    ViewData["Title"] = "Günlük Çalışma Raporu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-xl">
    <!-- Sayfa Başlığı -->
    <div class="page-header d-print-none my-3">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title">Günlük Çalışma Raporu</h2>
                <div class="text-muted mt-1">Gelişiminizi takip edebilmemiz için her gün yaptığınız çalışmaları, edindiğiniz kazanımları ve karşılaştığınız zorlukları buradan bildirmelisiniz.</div>
            </div>
        </div>
    </div>

    <div class="row row-cards">
        <!-- SOL TARAF: RAPOR GİRİŞ FORMU -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 bg-white">
                <div class="card-body">
                    <h3 class="card-title mb-4">Bugün Ne Yaptınız?</h3>
                    <form id="dailyReportForm">
                        <div class="mb-3">
                            <label class="form-label required">Çalışma Süresi (Saat)</label>
                            <input type="number" min="1" max="24" class="form-control" placeholder="Örn: 8" required id="reportDuration">
                        </div>
                        <div class="mb-3">
                            <label class="form-label required">Bugün Ne Yaptım?</label>
                            <textarea class="form-control" rows="4" placeholder="Yürüttüğünüz görevleri, yazdığınız modülleri detaylandırın..." required id="reportDone"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label required">Bugün Ne Öğrendim?</label>
                            <textarea class="form-control" rows="4" placeholder="Edindiğiniz yeni teknik bilgileri veya kazandığınız tecrübeleri yazın..." required id="reportLearned"></textarea>
                        </div>
                        <div class="mb-4">
                            <label class="form-label">Karşılaştığım Problemler (Varsa)</label>
                            <textarea class="form-control" rows="3" placeholder="Çözmekte zorlandığınız veya destek aldığınız teknik engeller..." id="reportProblems"></textarea>
                        </div>
                        <button type="button" class="btn btn-primary w-100" onclick="submitReport()">Raporu Gönder</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- SAĞ TARAF: GEÇMİŞ RAPORLAR (TEMİZLENDİ) -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 bg-white">
                <div class="card-body p-3">
                    <h3 class="card-title mb-3">Geçmiş Raporlarım</h3>
                    <div class="table-responsive">
                        <table id="reportsTable" class="table table-vcenter card-table table-striped">
                            <thead>
                                <tr>
                                    <th>Tarih</th>
                                    <th>Süre (Saat)</th>
                                    <th>Yapılan Çalışma</th>
                                    <th class="w-1">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Sahte veriler tamamen temizlendi, veri tabanı döngüsü buraya gelecek -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // DataTable entegrasyonu (Tablo boş olduğunda otomatik Türkçe 'Kayıt bulunamadı' yazar)
            $('#reportsTable').DataTable({
                "language": {
                    "url": "https://cdn.datatables.net/plug-ins/1.10.24/i18n/Turkish.json"
                },
                "responsive": true,
                "searching": true,
                "paging": true,
                "info": true
            });
        });

        function submitReport() {
            var form = document.getElementById('dailyReportForm');
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }
            form.reset();
            alert("Günlük raporunuz simülasyon olarak başarıyla gönderildi!");
        }
    </script>
}